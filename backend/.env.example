# Supply real credentials only in backend/.env (gitignored).
DATABASE_URL=
JWT_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:3000
# Set NODE_ENV=production for production; no-key CAPTCHA bypass is dev/test only.
NODE_ENV=development
# Google reCAPTCHA v2 Checkbox secret. Never use a NEXT_PUBLIC_ prefix here.
# FRONTEND_URL must include the exact frontend origin(s) registered with Google.
RECAPTCHA_SECRET_KEY=

# Use a distinct random secret with at least 32 characters.
EMAIL_VERIFICATION_SECRET=
# Fixed pickup service desk; optional override, not stored on each reservation.
PICKUP_LOCATION=Meja Layanan Sirkulasi
# Public frontend page; use HTTPS outside localhost.
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Temporary recipient for contact testing; SMTP sender remains MAIL_FROM.
CONTACT_RECIPIENT_EMAIL="adminposbankum@gmail.com"

# Distinct random secret, at least 32 characters; not either auth secret above.
PASSWORD_RESET_SECRET=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
