# Supply real credentials only in backend/.env (gitignored).
DATABASE_URL=
JWT_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:3000

# Use a distinct random secret with at least 32 characters.
EMAIL_VERIFICATION_SECRET=
# The full public backend endpoint; use HTTPS outside localhost.
EMAIL_VERIFICATION_URL=http://localhost:3001/auth/verify-email

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
