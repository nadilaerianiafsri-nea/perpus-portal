next-env.d.ts


# =========================================================
# ENVIRONMENT VARIABLES
# =========================================================

# Never commit real environment files
.env
.env.*
!.env.example

# Explicit local environment variants
.env.local
.env.development.local
.env.test.local
.env.production.local


