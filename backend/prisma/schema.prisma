generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  PENGUNJUNG
}

enum MemberType {
  UMUM
  MAHASISWA
  PEGAWAI
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(PENGUNJUNG)
  memberType    MemberType?
  emailVerified Boolean        @default(false)
  memberProfile MemberProfile?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model MemberProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  whatsapp       String   @db.VarChar(32)
  address        String   @db.Text
  identityNumber String
  universityName String?
  workUnit       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("member_profiles")
}

enum CollectionType {
  FISIK
  EBOOK
}

enum CopyStatus {
  TERSEDIA
  DIRESERVASI
  DIPINJAM
}

model Book {
  id          Int            @id @default(autoincrement())
  code        String         @unique @db.VarChar(64)
  title       String
  author      String
  isbnIssn    String?        @db.VarChar(64)
  publisher   String
  year        Int
  edition     String?
  language    String         @db.VarChar(64)
  subject     String
  type        CollectionType
  format      String         @db.VarChar(64)
  description String         @db.Text
  coverUrl    String
  shelf       String?
  ebookUrl    String?
  isDemo      Boolean        @default(false)
  copies      BookCopy[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type, year])
  @@index([language])
  @@index([subject])
  @@map("books")
}

model BookCopy {
  id       Int        @id @default(autoincrement())
  bookId   Int
  book     Book       @relation(fields: [bookId], references: [id], onDelete: Restrict)
  code     String     @unique @db.VarChar(80)
  status   CopyStatus @default(TERSEDIA)
  location String

  @@index([bookId, status])
  @@map("book_copies")
}

enum GrantStatus {
  MENUNGGU_VERIFIKASI
  SEDANG_DIPROSES
  SUDAH_DIKATALOGKAN
}

model BookGrant {
  id         Int         @id @default(autoincrement())
  title      String
  quantity   Int
  donorName  String
  receivedAt DateTime    @db.Date
  status     GrantStatus @default(MENUNGGU_VERIFIKASI)
  isDemo     Boolean     @default(false)
  seedKey    String?     @unique @db.VarChar(64)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, receivedAt])
  @@index([receivedAt])
  @@map("book_grants")
}
